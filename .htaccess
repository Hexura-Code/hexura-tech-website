# ─── Hexura Tech — Security & Performance Headers ───────────────────────────

# Custom 404 page (returns real HTTP 404 status, not a soft 404)
ErrorDocument 404 /404.html

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Redirect non-www to www
RewriteCond %{HTTP_HOST} ^hexura\.tech$ [NC]
RewriteRule ^(.*)$ https://www.hexura.tech/$1 [L,R=301]

# ─── Clean URLs (remove .html extension) ────────────────────────────────────

# Redirect requests that still include .html to the extension-less URL
# e.g. /portfolio.html -> /portfolio, /index.html -> /
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[?\s] [NC]
RewriteRule ^ /%1 [R=301,L]

# Redirect /index (with or without trailing content) to root
RewriteCond %{THE_REQUEST} \s/+index[?\s] [NC]
RewriteRule ^index$ / [R=301,L]

# Internally serve the .html file for clean URLs (no visible extension)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)$ $1.html [L]

# Same, one directory level deep (e.g. /insights/article-slug -> insights/article-slug.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
RewriteRule ^([^/]+)/([^/]+)$ $1/$2.html [L]

# ─── Security Headers ────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Enable XSS protection
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions policy — disable unused browser features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # HSTS — force HTTPS for 1 year (enable after SSL is confirmed working)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Content Security Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.web3forms.com https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com; frame-src https://calendly.com; object-src 'none';"
</IfModule>

# ─── Hide sensitive files ─────────────────────────────────────────────────────
<Files "config.js">
  # config.js must be readable by browser — key is domain-restricted via Web3Forms
</Files>

# Block access to hidden files (e.g. .git, .env)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Block access to backup and config files
<FilesMatch "\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ─── Performance ──────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Enable Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript
</IfModule>
